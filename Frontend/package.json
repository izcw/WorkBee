{
  "name": "aivra-frontend",
  "description": "Aivra desktop agent workspace",
  "author": "Aivra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.aivra.desktop",
    "productName": "Aivra",
    "icon": "electron/Aivra.png",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": { "icon": "electron/Aivra.png", "category": "public.app-category.productivity", "target": ["dmg", "zip"] },
    "win": { "icon": "electron/Aivra.png", "target": "nsis" },
    "linux": { "icon": "electron/Aivra.png", "target": "AppImage" }
  }
}
