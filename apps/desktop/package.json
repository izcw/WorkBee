{
  "name": "@aivra/desktop",
  "description": "WorkBee desktop agent workspace",
  "author": "Aivra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:desktop && npm run test:protocol && npm run agent:test",
    "test:desktop": "node --test tests/*.test.cjs",
    "test:protocol": "npm --prefix ../../packages/protocol test",
    "agent:setup": "node scripts/setup-agent.mjs",
    "agent:test": "node scripts/test-agent.mjs",
    "agent:build": "node scripts/build-agent.mjs",
    "desktop:pack": "npm run build && npm run agent:build && electron-builder --dir",
    "desktop:dist": "npm run build && npm run agent:build && electron-builder"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.aivra.desktop",
    "productName": "WorkBee",
    "electronDist": "node_modules/electron/dist",
    "icon": "electron/logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agent/dist/aivra-agent",
        "to": "agent/aivra-agent"
      }
    ],
    "mac": {
      "icon": "electron/logo.png",
      "category": "public.app-category.productivity",
      "target": "dmg",
      "artifactName": "WorkBee-Agent-v${version}-macos-${arch}.${ext}"
    },
    "win": {
      "icon": "electron/logo.png",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "WorkBee-Agent-v${version}-windows-portable.${ext}"
    },
    "nsis": {
      "artifactName": "WorkBee-Agent-Setup-v${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "electron/logo.png",
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.4"
  }
}
