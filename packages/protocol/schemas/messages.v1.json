{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbee.local/protocol/messages.v1.json",
  "title": "WorkBee message payload catalogue v1",
  "type": "object",
  "required": ["type", "payload"],
  "properties": {
    "type": {
      "enum": [
        "runtime.hello", "runtime.ready", "runtime.health", "runtime.shutdown",
        "workspace.select", "workspace.selected", "thread.list", "thread.get", "thread.created", "thread.truncate",
        "run.create", "run.created", "run.cancel", "run.started", "run.completed", "run.failed", "run.cancelled", "run.recoverable", "run.resume",
        "model.generating", "model.delta", "model.replace", "tool.requested", "tool.completed", "approval.required", "approval.resolve", "settings.status",
        "team.selecting", "team.selected", "agent.started", "agent.completed", "agent.failed", "knowledge.indexing", "knowledge.indexed",
        "quality.started", "quality.completed", "quality.failed"
      ]
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
